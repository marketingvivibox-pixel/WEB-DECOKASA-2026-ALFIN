{% comment %}Independent high-resolution WebP artwork generated from the approved mockup. Image pickers can override these defaults.{% endcomment %}
{% liquid
  assign artwork = 'decokasa-' | append: crop | append: '.webp'
  case crop
    when 'hero'
      assign art_width = 1906
      assign art_height = 825
    when 'hogar'
      assign art_width = 1860
      assign art_height = 846
    when 'xion'
      assign art_width = 1860
      assign art_height = 846
    when 'baby'
      assign art_width = 1860
      assign art_height = 846
    when 'biflex'
      assign art_width = 1859
      assign art_height = 846
    when 'logo'
      assign art_width = 2079
      assign art_height = 756
    when 'promo'
      assign art_width = 2172
      assign art_height = 724
  endcase
%}
<div class="mockup-crop crop-{{ crop }}" aria-hidden="true"><img src="{{ artwork | asset_url }}" alt="" width="{{ art_width }}" height="{{ art_height }}" loading="{{ loading | default: 'lazy' }}"></div>
