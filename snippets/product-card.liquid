<article class="card"><a href="{{ product.metafields.decokasa.landing_url.value | default: product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 700', sizes: '(min-width: 900px) 33vw, 100vw', class: 'art' }}{% else %}{% render 'demo-art' %}{% endif %}</a><div class="card-body"><span class="tag">{{ product.vendor | escape }}</span><h3>{{ product.title | escape }}</h3><p>Importe y disponibilidad por confirmar con asesor.</p><a class="button outline" href="{{ product.metafields.decokasa.landing_url.value | default: product.url }}">Ver producto →</a></div></article>