{% if product != blank %}<div class="wrap"><div class="breadcrumb"><a href="{{ routes.all_products_collection_url }}">Catálogo</a><span>/ {{ product.vendor | escape }}</span></div><section class="product-grid"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: widths: '500, 1000', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'eager', class: 'art' }}{% else %}{% if pvc %}{% render 'pvc-art' %}{% else %}{% render 'demo-art' %}{% endif %}{% endif %}<p class="note">Disponibilidad pendiente de confirmación por asesor.</p></div><div><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><div class="rte">{{ product.description }}</div><p class="price" data-product-price>{{ product.selected_or_first_available_variant.price | money_with_currency }}</p><small>Importe orientativo. El asesor confirmará el total y la entrega.</small><dl class="detail"><div><dt>SKU</dt><dd data-sku>{{ product.selected_or_first_available_variant.sku | escape }}</dd></div><div><dt>Disponibilidad</dt><dd>Consultar con asesor</dd></div></dl>{% if pvc or product.metafields.decokasa.coverage_m2.value != blank %}{% render 'pvc-calculator' %}{% endif %}{% render 'request-form', product: product %}</div></section></div>{% else %}<section class="wrap section"><h1>Landing en preparación</h1><p>Selecciona el producto de esta landing en el editor del tema.</p></section>{% endif %}