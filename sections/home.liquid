<section class="home-hero" aria-labelledby="home-title"><div class="wrap home-hero-grid"><div class="hero-copy"><h1 id="home-title">{{ section.settings.heading | escape }}<span>{{ section.settings.heading_accent | escape }}</span></h1><div class="actions"><a class="button yellow" href="{{ routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}{% render 'icon', name: 'arrow' %}</a><a class="button outline" href="{{ routes.all_products_collection_url }}">Ver categorías{% render 'icon', name: 'arrow' %}</a></div><div class="hero-benefits"><div>{% render 'icon', name: 'truck' %}<span>Coordina<br>tu envío</span></div><div>{% render 'icon', name: 'shield' %}<span>Compra<br>con asesor</span></div><div>{% render 'icon', name: 'form' %}<span>Solicita<br>tu producto</span></div><div>{% render 'icon', name: 'headphones' %}<span>Atención<br>personalizada</span></div></div></div><div class="hero-media">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1600 | image_tag: widths: '640, 960, 1600', sizes: '(min-width: 900px) 56vw, 100vw', loading: 'eager', class: 'hero-photo' }}{% else %}{% render 'reference-image', crop: 'hero', loading: 'eager' %}{% endif %}</div></div></section>
<section class="wrap home-brands" id="marcas" aria-labelledby="brands-title"><h2 id="brands-title">Nuestras marcas</h2><div class="brands visual-brands">
<a class="brand decokasa brand-visual" href="{{ routes.collections_url }}/vendors?q=DECOKASA"><strong class="sr-only">DECOKASA</strong><span class="sr-only"> · Pisos PVC y SPC, paneles PVC, wall panel, alfombras y artículos para el hogar</span>{% if section.settings.decokasa_image != blank %}{{ section.settings.decokasa_image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 900px) 24vw, (min-width: 600px) 48vw, 100vw', loading: 'lazy', class: 'brand-photo', alt: '' }}{% else %}{% render 'reference-image', crop: 'hogar' %}{% endif %}<span class="brand-go">{% render 'icon', name: 'arrow' %}</span></a>
<a class="brand xion brand-visual" href="{{ routes.collections_url }}/vendors?q=Xion"><strong class="sr-only">XION</strong><span class="sr-only"> · Tecnología y electrodomésticos</span>{% if section.settings.xion_image != blank %}{{ section.settings.xion_image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 900px) 24vw, (min-width: 600px) 48vw, 100vw', loading: 'lazy', class: 'brand-photo', alt: '' }}{% else %}{% render 'reference-image', crop: 'xion' %}{% endif %}<span class="brand-go">{% render 'icon', name: 'arrow' %}</span></a>
<a class="brand biflex brand-visual" href="{{ routes.collections_url }}/vendors?q=Biflex"><strong class="sr-only">BIFLEX</strong><span class="sr-only"> · Activa tu día</span>{% if section.settings.biflex_image != blank %}{{ section.settings.biflex_image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 900px) 24vw, (min-width: 600px) 48vw, 100vw', loading: 'lazy', class: 'brand-photo', alt: '' }}{% else %}{% render 'reference-image', crop: 'biflex' %}{% endif %}<span class="brand-go">{% render 'icon', name: 'arrow' %}</span></a>
<a class="brand baby brand-visual" href="{{ routes.collections_url }}/vendors?q=Mundo%20Baby"><strong class="sr-only">MUNDOBABY</strong><span class="sr-only"> · Para acompañar su crecimiento</span>{% if section.settings.baby_image != blank %}{{ section.settings.baby_image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 900px) 24vw, (min-width: 600px) 48vw, 100vw', loading: 'lazy', class: 'brand-photo', alt: '' }}{% else %}{% render 'reference-image', crop: 'baby' %}{% endif %}<span class="brand-go">{% render 'icon', name: 'arrow' %}</span></a>
</div></section>
<div class="wrap"><a class="opportunity" href="{{ routes.all_products_collection_url }}"><span class="opportunity-icon">{% render 'icon', name: 'tag' %}</span><span>{{ section.settings.promo_text | escape }}</span><span class="opportunity-go">{% render 'icon', name: 'arrow' %}</span><span class="opportunity-art" aria-hidden="true">{% render 'reference-image', crop: 'promo' %}</span></a></div>
{% if section.settings.featured_collection != blank %}<section class="wrap section home-featured"><div class="section-head"><h2>Explora el catálogo</h2><a href="{{ routes.all_products_collection_url }}">Ver todos {% render 'icon', name: 'arrow' %}</a></div><div class="cards">{% for product in section.settings.featured_collection.products limit: 3 %}{% render 'product-card', product: product %}{% endfor %}</div></section>{% endif %}
<section class="wrap section how-to" id="como-comprar"><div class="section-head"><div><p class="eyebrow">Así de fácil</p><h2>Elige. Solicita. Coordina.</h2></div><p>Tu próxima compra empieza aquí.</p></div><div class="buy-steps"><div><span class="step-number">01</span><div><h3>Encuentra tu producto</h3><p>Explora el catálogo por categoría o marca y conoce cada producto en su página.</p></div></div><div><span class="step-number">02</span><div><h3>Completa tu solicitud</h3><p>Indica la presentación y cantidad que necesitas en el formulario del producto.</p></div></div><div><span class="step-number">03</span><div><h3>Coordina con un asesor</h3><p>Confirma disponibilidad, importe final, forma de pago y entrega antes de comprar.</p></div></div></div></section>
<section class="wrap wholesale-section" id="mayorista"><div class="wholesale-banner"><div class="wholesale-symbol">{% render 'icon', name: 'box' %}</div><div><p class="eyebrow">División mayorista</p><h2>Más posibilidades para tu negocio.</h2><p>Explora los productos e indica la cantidad que buscas en tu solicitud.</p></div><a class="button yellow" href="{{ routes.all_products_collection_url }}">Ver productos {% render 'icon', name: 'arrow' %}</a></div></section>
{% assign whatsapp_phone = section.settings.whatsapp_phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.' %}
{% assign whatsapp_href = section.settings.whatsapp_url %}
{% assign whatsapp_text = section.settings.whatsapp_message | url_encode %}
{% if whatsapp_href == blank and whatsapp_phone != blank %}{% assign whatsapp_href = 'https://wa.me/' | append: whatsapp_phone | append: '?text=' | append: whatsapp_text %}{% endif %}
{% if whatsapp_href != blank %}<a class="whatsapp-float" href="{{ whatsapp_href }}" target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp: solicita ayuda o una cotización"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.02 3.2c-7.05 0-12.78 5.72-12.78 12.77 0 2.25.59 4.45 1.71 6.4L3.13 28.8l6.58-1.73a12.74 12.74 0 0 0 6.3 1.66h.01c7.04 0 12.77-5.73 12.77-12.78 0-3.41-1.33-6.62-3.74-9.03a12.69 12.69 0 0 0-9.03-3.72Zm0 23.36h-.01c-1.94 0-3.85-.52-5.51-1.51l-.4-.24-3.91 1.03 1.04-3.81-.26-.42a10.59 10.59 0 0 1-1.63-5.64c0-5.89 4.79-10.68 10.68-10.68 2.85 0 5.53 1.11 7.55 3.13a10.6 10.6 0 0 1 3.12 7.56c0 5.89-4.79 10.68-10.67 10.68Zm5.86-8c-.32-.16-1.9-.94-2.2-1.05-.3-.11-.51-.16-.72.16-.21.32-.83 1.05-1.02 1.27-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.58-1.6-.95-.85-1.59-1.9-1.78-2.22-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.1-.22.05-.4-.03-.56-.08-.16-.72-1.74-.98-2.39-.26-.63-.52-.55-.72-.56h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.08-1.11 2.64s1.14 3.06 1.3 3.27c.16.21 2.24 3.42 5.42 4.8.76.33 1.35.53 1.81.68.76.24 1.45.21 2 .13.61-.09 1.9-.77 2.17-1.51.27-.75.27-1.38.19-1.51-.08-.14-.29-.22-.61-.38Z"/></svg><span>WhatsApp</span></a>{% endif %}
{% schema %}
{
  "name": "Inicio multimarcas",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "Todo lo que necesitas,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Título en amarillo",
      "default": "en un solo lugar."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Botón principal",
      "default": "Explorar catálogo"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen principal (solo fotografía)"
    },
    {
      "type": "paragraph",
      "content": "Artes WebP de alta resolución incluidos. Puedes sustituirlos aquí. Fotografía principal recomendada: 1906 × 825 px o superior. Tarjetas: 1860 × 846 px o superior."
    },
    {
      "type": "image_picker",
      "id": "decokasa_image",
      "label": "Imagen DECOKASA"
    },
    {
      "type": "image_picker",
      "id": "xion_image",
      "label": "Imagen Xion"
    },
    {
      "type": "image_picker",
      "id": "biflex_image",
      "label": "Imagen Biflex"
    },
    {
      "type": "image_picker",
      "id": "baby_image",
      "label": "Imagen Mundo Baby"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Texto de la franja",
      "default": "Descubre todo lo que tenemos para ti."
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "WhatsApp de atención (con código de país)",
      "info": "Solo números; por ejemplo, 51987654321. Déjalo vacío para ocultar el botón."
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "Enlace de WhatsApp (wa.me o wa.link)",
      "info": "Alternativa al número. Si usas wa.link, el mensaje debe estar preconfigurado en ese enlace."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensaje prellenado de WhatsApp",
      "default": "Hola, visité la tienda DECOKASA y quisiera ayuda con un producto o una cotización."
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Colección destacada"
    }
  ],
  "presets": [
    {
      "name": "Inicio multimarcas"
    }
  ]
}
{% endschema %}
