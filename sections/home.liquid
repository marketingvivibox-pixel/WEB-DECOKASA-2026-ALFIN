<section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">Todo para tu día a día</p><h1>Todo lo que necesitas,<br><span>en un solo lugar.</span></h1><p>Descubre productos para tu hogar, tu familia y tu próximo proyecto. Elige lo que necesitas y recibe atención de un asesor.</p><div class="actions"><a class="button yellow" href="{{ routes.all_products_collection_url }}">Explorar el catálogo →</a><a class="button outline" href="#marcas">Ver nuestras marcas</a></div></div>{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'art', widths: '480, 800, 1200', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'eager' }}{% else %}{% render 'demo-art' %}{% endif %}</div></section><div class="wrap trust"><div><strong>Encuentra tu producto</strong><small>Explora por marca o categoría.</small></div><div><strong>Solicita tu compra</strong><small>Comparte lo que necesitas en el formulario.</small></div><div><strong>Coordina con un asesor</strong><small>Confirma disponibilidad e importe final.</small></div></div><section class="wrap section" id="marcas"><div class="section-head"><h2>Nuestras marcas</h2><a href="{{ routes.all_products_collection_url }}">Ver todo →</a></div><div class="brands"><a class="brand xion" href="{{ routes.collections_url }}/vendors?q=Xion"><strong>XION</strong><small>Tecnología y electrodomésticos →</small></a><a class="brand baby" href="{{ routes.collections_url }}/vendors?q=Mundo%20Baby"><strong>MUNDO<br>BABY</strong><small>Para acompañar su crecimiento →</small></a><a class="brand biflex" href="{{ routes.collections_url }}/vendors?q=Biflex"><strong>BIFLEX</strong><small>Activa tu día →</small></a><a class="brand mayor" href="#mayorista"><strong>DECOKASA</strong><small>Consultas para tu negocio →</small></a></div></section><section class="wrap section"><div class="section-head"><h2>Explora el catálogo</h2><a href="{{ routes.all_products_collection_url }}">Elegir por categoría →</a></div><div class='cards'>{% for product in section.settings.featured_collection.products limit: 3 %}{% render 'product-card', product: product %}{% else %}<p class='note'>Selecciona una colección en el editor para mostrar productos.</p>{% endfor %}</div></section><section class="wrap section" id="mayorista"><div class="banner"><div><p class="eyebrow">Para tu negocio</p><h2>¿Buscas productos por volumen?</h2><p>Elige un producto y cuéntanos la cantidad que necesitas.</p></div><a class="button" href="{{ routes.all_products_collection_url }}">Consultar productos →</a></div></section>
{% schema %}
{"name": "Inicio multimarcas", "settings": [{"type": "image_picker", "id": "hero_image", "label": "Imagen principal"}, {"type": "collection", "id": "featured_collection", "label": "Colección destacada"}], "presets": [{"name": "Inicio multimarcas"}]}
{% endschema %}
